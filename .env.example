# NetSentinel AI - Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Mode
DEBUG=False
PROJECT_NAME="NetSentinel AI"

# Database Configuration (Defaults to local SQLite in data/netsentinel.db)
# DATABASE_URL=sqlite:///data/netsentinel.db

# Frontend uses this base URL when served from a LAN/private demo URL.
# VITE_API_BASE_URL=http://192.168.0.103:8000/api

# JSON list of allowed browser origins for the backend.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://192.168.0.103:5173"]

# Optional Google Gemini API Key
# If configured, the AI Investigation Copilot will use Gemini for advanced synthesis.
# If omitted or left blank, the Copilot automatically uses the local evidence-grounded engine.
GEMINI_API_KEY=

# File Limits
MAX_UPLOAD_SIZE_MB=100
MAX_ANALYSIS_ROWS=150000
